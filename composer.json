{
  "name": "byjg/cache-engine",
  "description": "A powerful, versatile cache implementation providing both PSR-6 and PSR-16 interfaces with support for multiple storage drivers.",
  "autoload": {
    "psr-4": {
      "ByJG\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3 <8.7",
    "psr/cache": "^1.0|^2.0|^3.0",
    "psr/log": "^1.0|^2.0|^3.0",
    "psr/simple-cache": "^2.0|^3.0",
    "psr/container": "^1.0|^1.1|^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "ext-memcached": "*",
    "ext-redis": "*",
    "ext-shmop": "*"
  },
  "provide": {
    "psr/cache-implementation": "1.0",
    "psr/simple-cache-implementation": "2.0|3.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
